    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.id_lead, l.nombre, l.producto_servicio, l.mensaje_original\nFROM tbl_lead l\nWHERE l.estado = 'interesado'\n  AND COALESCE(l.ultimo_contacto_at, l.updated_at) < now() - interval '3 days'\n  AND NOT EXISTS (\n    SELECT 1 FROM tbl_borrador b\n    WHERE b.id_lead = l.id_lead AND b.estado = 'pendiente'\n  )\nLIMIT 5;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
