    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tbl_lead (nombre, correo, telefono, mensaje_original, interes, producto_servicio, prioridad)\nVALUES ($1, $2, $3, $4, $5, $6, $7)\nON CONFLICT (correo) DO UPDATE SET\n  nombre = EXCLUDED.nombre,\n  telefono = EXCLUDED.telefono,\n  mensaje_original = EXCLUDED.mensaje_original,\n  interes = COALESCE(EXCLUDED.interes, tbl_lead.interes),\n  producto_servicio = CASE\n      WHEN EXCLUDED.producto_servicio IS NULL OR EXCLUDED.producto_servicio = 'otro'\n      THEN tbl_lead.producto_servicio\n      ELSE EXCLUDED.producto_servicio END,\n  prioridad = COALESCE(EXCLUDED.prioridad, tbl_lead.prioridad),\n  updated_at = NOW()\nRETURNING *, (xmax = 0) AS es_nuevo;",
        "options": {
          "queryReplacement": "={{ [$json.nombre, $json.correo, $json.telefono, $json.mensaje_original, $json.interes, $json.producto_servicio, $json.prioridad] }}"
        }
