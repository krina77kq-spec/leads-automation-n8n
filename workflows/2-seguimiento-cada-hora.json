    {
      "parameters": {
        "jsCode": "const lead = $('Webhook').first().json.body ?? $('Webhook').first().json;\nlet clasif = {};\ntry {\n  const raw = $input.first().json;\n  const texto = raw.candidates?.[0]?.content?.parts?.[0]?.text;\n  clasif = texto ? JSON.parse(texto) : {};\n} catch (e) { clasif = {}; }\n\nconst validos = {\n  interes: ['alto','medio','bajo'],\n  prioridad: ['alta','media','baja'],\n  producto_servicio: ['automatizacion_ia','chatbots_atencion','marketing_redes',\n                      'publicidad_pagada','web_embudos','consultoria','otro']\n};\nconst limpio = (campo) => validos[campo].includes(clasif[campo]) ? clasif[campo] : null;\n\nreturn [{ json: {\n  ...lead,\n  mensaje_original: lead.mensaje,\n  interes: limpio('interes'),\n  producto_servicio: limpio('producto_servicio'),\n  prioridad: limpio('prioridad')\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -352,
        -576
      ],
      "id": "81c7dd09-b06b-416c-83cc-db8564ac9a61",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT r.*\nFROM tbl_lead l,\n     LATERAL cambiar_estado(l.id_lead, 'interesado', 'ia') r\nWHERE l.id_lead = $1\n  AND l.estado = 'contactado'\n  AND $2::text = 'alto'\n  AND $3::text = 'contactado';",
        "options": {
          "queryReplacement": "={{ [ $json.id_lead,$json.interes ,$json.estado ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
