    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT cambiar_estado(\n  id_lead,\n  CASE estado WHEN 'convertido' THEN 'interesado' WHEN 'perdido' THEN 'contactado' END,\n  'reescribio'\n)\nFROM tbl_lead\nWHERE id_lead = $1 AND estado IN ('convertido', 'perdido');",
        "options": {
          "queryReplacement": "={{ $json.id_lead }}"
