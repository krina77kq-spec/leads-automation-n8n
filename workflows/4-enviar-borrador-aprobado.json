        "operation": "executeQuery",
        "query": "UPDATE tbl_borrador b\nSET estado = 'aprobado', resuelto_en = now()\nFROM tbl_lead l\nWHERE b.id_borrador = $1\n  AND b.estado = 'pendiente'\n  AND l.id_lead = b.id_lead\nRETURNING b.id_borrador, b.id_lead, b.asunto, b.cuerpo, l.correo, l.nombre;",
        "options": {
          "queryReplacement": "={{ [ $json.body.id_borrador ] }}"
        }
