      "parameters": {
        "operation": "executeQuery",
        "query": "WITH b AS (\n  UPDATE tbl_borrador SET enviado_en = now()\n  WHERE id_borrador = $1\n  RETURNING id_lead\n)\nUPDATE tbl_lead\nSET ultimo_contacto_at = now()\nFROM b\nWHERE tbl_lead.id_lead = b.id_lead\nRETURNING tbl_lead.id_lead, tbl_lead.ultimo_contacto_at;",
        "options": {
          "queryReplacement": "={{ [ $('Reclamar borrador').item.json.id_borrador ] }}"
        }
