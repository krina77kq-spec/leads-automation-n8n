# Copia este archivo a .env y reemplaza los valores CAMBIAME.
# El archivo .env real NO se sube al repositorio.

# --- PostgreSQL (se aplican solo al crear la base por primera vez) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=CAMBIAME
POSTGRES_DB=leads

# --- n8n ---
# Cifra las credenciales guardadas en n8n. Conservarla mientras exista el volumen n8n_data.
N8N_ENCRYPTION_KEY=CAMBIAME_CADENA_LARGA_ALEATORIA
# Solo la base, con la barra final.
WEBHOOK_URL=http://localhost:5678/
